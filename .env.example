# Copy to .env and fill in. Loaded by expenses.config.Settings (prefix EXPENSES_).

# --- Enable Banking ---
EXPENSES_EB_API_BASE_URL=https://api.enablebanking.com
EXPENSES_EB_APPLICATION_ID=your-application-id
EXPENSES_EB_PRIVATE_KEY_PATH=./secrets/enablebanking_private_key.pem
# Obtained from the one-time consent/session flow (POST /sessions -> accounts[].uid)
EXPENSES_EB_ACCOUNT_UID=
EXPENSES_EB_TRANSACTION_STATUS=BOOK
# Must match a redirect URL whitelisted when you registered the application.
EXPENSES_EB_REDIRECT_URL=http://localhost:8000/callback

# --- Polling ---
EXPENSES_POLL_INTERVAL_SECONDS=900
EXPENSES_POLL_LOOKBACK_DAYS=7
EXPENSES_EXPECTED_CURRENCY=EUR

# --- Google Sheets ---
# Service-account JSON key. IMPORTANT: also share the spreadsheet with the
# service account's client_email (Editor) — project IAM roles are not enough.
EXPENSES_GOOGLE_CREDENTIALS_PATH=./secrets/google_service_account.json
# Current-year spreadsheet id (from the sheet URL). Not a secret.
EXPENSES_GOOGLE_SPREADSHEET_ID=
EXPENSES_SUPPORT_SHEET_NAME=Support
EXPENSES_IGNORE_SHEET_NAME=Ignore

# --- HTTP server (expenses-serve) ---
# Only a /health endpoint is exposed; the poll loop runs internally.
EXPENSES_SERVER_HOST=127.0.0.1
EXPENSES_SERVER_PORT=8000

# --- Telegram ---
EXPENSES_TELEGRAM_BOT_TOKEN=
# Discover by sending /start to the bot while `expenses-telegram run` is polling.
EXPENSES_TELEGRAM_CHAT_ID=
